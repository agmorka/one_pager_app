{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "One Pager Structure Definition v2",
  "description": "Schema for Data Product One Pager documents. The top-level 'required' list and every 'minItems' / 'minLength' define the strict (Submit for Review) tier; the lenient (Save Draft) tier ignores them and only requires productName and description (Requirements_and_Scope.md §5). Changes from v1: useCases hold Use Case ID references only (content lives in the use_cases table); businessRequirements carry BR-### IDs; the data element grid (dataProductPreview), retentionRequirements, dataGovernanceArtifacts, outOfScope, openQuestions and assumptions are added.",
  "type": "object",
  "required": [
    "structureDefinition",
    "dataProduct",
    "productName",
    "description",
    "businessDomain",
    "dataProductType",
    "onePagerStatus",
    "dataProductStatus",
    "version",
    "dataProductOwner",
    "businessProblemStatement",
    "useCases",
    "businessRequirements",
    "dataSources",
    "dataProductPreview",
    "dataClassification"
  ],
  "definitions": {
    "person": {
      "type": "object",
      "required": ["name", "initials", "email"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "initials": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "team": { "type": "string" }
      }
    },
    "useCaseId": { "type": "string", "pattern": "^UC-\\d{3,}$" },
    "priority": { "type": "string", "enum": ["Must Have", "High", "Medium", "Low"] }
  },
  "properties": {
    "structureDefinition": {
      "type": "string",
      "description": "Schema version this document follows (file name inside schemas/)."
    },
    "dataProduct": {
      "type": "string",
      "description": "Registered unique name of the Data Product."
    },
    "productName": {
      "type": "string",
      "description": "Human-readable product name.",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Description of the Data Product.",
      "minLength": 1
    },
    "businessDomain": {
      "type": "string",
      "description": "Business domain."
    },
    "dataProductType": {
      "type": "string",
      "enum": ["Foundational", "Integrated", "Augmented"]
    },
    "onePagerStatus": {
      "type": "string",
      "enum": ["Draft", "Ready for Review", "In Review", "Approved", "Draft Update", "Cancelled"]
    },
    "dataProductStatus": {
      "type": "string",
      "enum": ["In Definition", "Ready for Development", "In Development", "Active", "In Enhancement", "Deprecated", "Cancelled"]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "dataProductOwner": { "$ref": "#/definitions/person" },
    "smes": {
      "type": "array",
      "items": { "$ref": "#/definitions/person" }
    },
    "businessProblemStatement": {
      "type": "string",
      "minLength": 1
    },
    "useCases": {
      "type": "array",
      "description": "References to Use Cases in the shared use_cases table.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["useCaseId"],
        "properties": {
          "useCaseId": { "$ref": "#/definitions/useCaseId" }
        }
      }
    },
    "businessRequirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "requirement"],
        "properties": {
          "id": { "type": "string", "pattern": "^BR-\\d{3,}$" },
          "requirement": { "type": "string", "minLength": 1 },
          "priority": { "$ref": "#/definitions/priority" },
          "notes": { "type": "string" }
        }
      }
    },
    "dataSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "dataProvided"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sourceSystem": { "type": "string" },
          "epoId": { "type": "string" },
          "dataProvided": { "type": "string", "minLength": 1 },
          "refreshFrequency": { "type": "string" }
        }
      }
    },
    "dataProductPreview": {
      "type": "array",
      "description": "Data element grid of the Data Product.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["elementName", "dataType", "description", "isCriticalDataElement"],
        "properties": {
          "elementName": { "type": "string", "minLength": 1 },
          "dataType": { "type": "string", "minLength": 1 },
          "isPrimaryKey": { "type": "boolean" },
          "containsPII": { "type": "boolean" },
          "isCriticalDataElement": { "type": "boolean" },
          "cdeCriticalityTiering": {
            "type": ["string", "null"],
            "description": "Only when isCriticalDataElement is true; otherwise null."
          },
          "description": { "type": "string", "minLength": 1 },
          "example": { "type": "string" },
          "source": { "type": "string" },
          "useCaseLinks": {
            "type": ["array", "null"],
            "description": "Only when isCriticalDataElement is true; otherwise null.",
            "items": { "$ref": "#/definitions/useCaseId" }
          }
        }
      }
    },
    "dataClassification": {
      "type": "object",
      "required": ["classificationLevel", "containsPII", "containsSensitiveData"],
      "properties": {
        "classificationLevel": {
          "type": "string",
          "enum": ["Public", "Internal", "Confidential", "Restricted"]
        },
        "containsPII": { "type": "boolean" },
        "containsSensitiveData": { "type": "boolean" }
      }
    },
    "retentionRequirements": {
      "type": "array",
      "description": "Required (at least one) when containsPII or containsSensitiveData is true, or classificationLevel is not Public.",
      "items": {
        "type": "object",
        "required": ["dataCategory", "retentionPeriod"],
        "properties": {
          "dataCategory": { "type": "string", "minLength": 1 },
          "retentionPeriod": { "type": "string", "minLength": 1 },
          "legalBasis": { "type": "string" }
        }
      }
    },
    "dataGovernanceArtifacts": {
      "type": "object",
      "properties": {
        "businessConcepts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "definition"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "definition": { "type": "string", "minLength": 1 }
            }
          }
        },
        "cdeQuality": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["elementName", "dimension", "rule"],
            "properties": {
              "elementName": { "type": "string", "minLength": 1 },
              "dimension": {
                "type": "string",
                "enum": ["Completeness", "Accuracy", "Consistency", "Timeliness", "Validity", "Uniqueness"]
              },
              "rule": { "type": "string", "minLength": 1 },
              "threshold": { "type": "string" }
            }
          }
        },
        "cdeLineage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["elementName", "sourceSystem"],
            "properties": {
              "elementName": { "type": "string", "minLength": 1 },
              "sourceSystem": { "type": "string", "minLength": 1 },
              "sourceField": { "type": "string" },
              "transformation": { "type": "string" }
            }
          }
        }
      }
    },
    "outOfScope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "status"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "owner": { "type": "string" },
          "dueDate": { "type": "string", "format": "date" },
          "status": { "type": "string", "enum": ["Open", "Answered", "Closed"] },
          "answer": { "type": "string" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "createdBy": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "lastUpdated": { "type": "string", "format": "date-time" },
    "changeLog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": { "type": "string" },
          "date": { "type": "string", "format": "date-time" },
          "author": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
