# Local configuration for the One Pager App.
#
# Copy this file to `.env` (git-ignored) and adjust the values, then start the
# app from the `app/` directory so Streamlit picks up `app/.streamlit/config.toml`:
#
#   cd app && uv run --env-file ../.env streamlit run app.py
#
# Every variable maps to a field of `onepagerapp.config.AppConfig`.

# --- Mode -------------------------------------------------------------------
# local-mock        in-memory data, no Databricks connection (default for local work)
# local-integration real Delta tables through a SQL warehouse (needs CLI auth)
# databricks        deployed Databricks App (set by the platform, not locally)
APP_MODE=local-mock

# --- Environment badge ------------------------------------------------------
# DEV / INT / UAT / PRD. Leave empty to derive it from the catalog prefix.
ONE_PAGER_APP_ENVIRONMENT=DEV

# --- One Pager documents (YAML) ---------------------------------------------
# local-mock: folder with sample documents, relative to the directory Streamlit
#             is started from (app/). New documents go to a temporary folder.
# local-integration: the Unity Catalog volume, e.g.
#             /Volumes/dev_bia_meta/onepager_app/one_pager_registry
ONE_PAGER_APP_VOLUME_PATH=../tests/fixtures/sample_one_pagers

# --- Delta tables (local-integration and databricks) ------------------------
ONE_PAGER_APP_DATABRICKS_CATALOG=dev_bia_meta
ONE_PAGER_APP_DATABRICKS_SCHEMA=onepager_app
# SQL warehouse ID. Any placeholder works in local-mock mode.
DATABRICKS_WAREHOUSE_ID=abc123
# Databricks CLI profile used for authentication in local-integration mode.
DATABRICKS_CONFIG_PROFILE=dev

# --- Edit locks -------------------------------------------------------------
# Seconds an edit lock lives after the editor's last re-run (default 30 min).
ONE_PAGER_APP_LOCK_TTL_SECONDS=1800

# --- Logging / telemetry ----------------------------------------------------
CLOUD_ROLE_NAME=OnePagerApp

# --- Streamlit ----------------------------------------------------------------
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
